#include <stdio.h>
#define size 10
int main(){
    int hashtable[size];
    int n,key,index,i,j;
    for(i=0;i<size;i++)
        hashtable[i] = -1;
    printf("Enter number of keys: ");
    scanf("%d",&n);
    if(n>size){
        printf("Maximum you can enter is %d\n", size);
        return 0;
    }
    for(i=0;i<n;i++){
        printf("Enter key: ");
        scanf("%d",&key);
        index=key%size;
        j=1;
        while(hashtable[index]!=-1){
            index=(key%size+j*j)%size;
            j++;
        }
        hashtable[index]=key;
    }
    printf("\nHash Table:\n");
    for(i=0;i<size;i++){
        printf("Index %d : %d\n",i,hashtable[i]);
    }
    return 0;
}
