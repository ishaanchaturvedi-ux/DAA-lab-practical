#include<stdio.h>
#define size 100
int main(){
    int arr[size],hash[size];
    int n,i,index;
    for(i=0;i<size;i++)
        hash[i]=0;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements:\n");
    for(i=0;i<n;i++){
        scanf("%d",&arr[i]);
        index=arr[i]%size;
        if(index<0)
            index=index+size;
        hash[index]++;
    }
    printf("\nFrequency of elements:\n");
    for(i=0;i<size;i++){
        if(hash[i]>0)
            printf("Element %d : %d times\n", i, hash[i]);
    }
    return 0;
}
