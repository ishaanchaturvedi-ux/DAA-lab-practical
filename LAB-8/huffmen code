
#include <stdio.h>
#include <stdlib.h>
struct Node {
    char ch;
    int freq;
    struct Node *left ,*right;
};
struct Node* createNode(char ch,int freq){
    struct Node* node=malloc(sizeof(struct Node));
    node->ch=ch;
    node->freq=freq;
    node->left=node->right=NULL;
    return node;
}
void printCodes(struct Node* root,int code[],int top){
    if(root==NULL)
        return;
    if(root->left==NULL&&root->right==NULL){
        printf("%c: ",root->ch);
        if(top==0)
            printf("0");
        for (int i=0;i<top;i++)
            printf("%d",code[i]);
        printf("\n");
        return;
    }
    code[top]=0;
    printCodes(root->left,code,top+1);
    code[top]=1;
    printCodes(root->right,code,top+1);
}
int main(){
    int n,freq;
    char ch;
    struct Node* nodes[100];
    int code[100];
    printf("Enter number of characters: ");
    scanf("%d",&n);
    if(n<1||n>100){
        printf("Invalid number of characters.\n");
        return 1;
    }
    for(int i=0;i<n;i++){
        printf("Enter character and frequency: ");
        scanf(" %c %d",&ch,&freq);
        if(freq<=0){
            printf("Frequency must be positive.\n");
            return 1;
        }
        nodes[i]=createNode(ch,freq);
    }
    while(n>1){
        int min1=0,min2=1;
        if(nodes[min1]->freq>nodes[min2]->freq){
            int temp=min1;
            min1=min2;
            min2=temp;
        }
        for(int i=2;i<n;i++){
            if(nodes[i]->freq<nodes[min1]->freq){
                min2=min1;
                min1=i;
            }else if(nodes[i]->freq<nodes[min2]->freq){
                min2=i;
            }
        }
        struct Node* parent=createNode(
            '$', nodes[min1]->freq+nodes[min2]->freq
        );
        parent->left=nodes[min1];
        parent->right=nodes[min2];
        if(min1>min2){
            int temp=min1;
            min1=min2;
            min2=temp;
        }
        nodes[min2]=nodes[n-1];
        nodes[min1]=parent;
        n--;
    }
    printf("\nHuffman Codes:\n");
    printCodes(nodes[0],code,0);
    return 0;
}
