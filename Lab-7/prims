#include<stdio.h>
#include<stdlib.h>
#define MAX 100
#define INF 999
int main(){
    int V,i,j;
    int graph[MAX][MAX];
    int selected[MAX]={0};
    int edges=0;
    int total= 0;
    printf("Enter number of vertices: ");
    scanf("%d", &V);
    printf("Enter adjacency matrix:\n");
    for(i=0;i<V;i++){
        for(j=0;j<V;j++){
            scanf("%d", &graph[i][j]);
            if(graph[i][j]==0)
                graph[i][j]=INF;
        }
    }
    selected[0]=1;
    printf("\nEdges in MST:\n");
    while(edges<V-1){
        int min=INF;
        int x=-1;
        int y=-1;
        for(i=0;i<V;i++){
            if(selected[i]){
                for(j=0;j<V;j++){
                    if(!selected[j]&&graph[i][j]<min){
                        min=graph[i][j];
                        x=i;
                        y=j;
                    }
                }
            }
        }
        if(x==-1){
            printf("Graph is not connected.\n");
            return 0;
        }
        printf("%d - %d : %d\n", x, y, min);
        total+=min;
        selected[y]=1;
        edges++;
    }
    printf("Total MST weight = %d\n", total);
    return 0;
}
