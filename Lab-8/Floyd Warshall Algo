#include <stdio.h>
#define INF 99999
void printMatrix(int dist[][100],int n){
    int i,j;
    printf("\nShortest Distance Matrix:\n");
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            if(dist[i][j]==INF)
                printf("%7s","INF");
            else
                printf("%7d",dist[i][j]);
        }
        printf("\n");
    }
}
void floydWarshall(int graph[][100],int n){
    int dist[100][100];
    int i,j,k;
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            dist[i][j]=graph[i][j];
        }
    }
    for(k=0;k<n;k++){
        for(i=0;i<n;i++){
            for(j=0;j<n;j++){
                if(dist[i][k]!=INF&&dist[k][j]!=INF && dist[i][j]>dist[i][k]+dist[k][j]){
                    dist[i][j]=dist[i][k]+dist[k][j];
                }
            }
        }
    }
    for(i=0;i<n;i++){ 
         if(dist[i][i]<0){
            printf("\nGraph contains a negative weight cycle.\n");
            return;
        }
    }
    printMatrix(dist, n);
}
int main(){
    int graph[100][100];
    int n,i,j;
    printf("Enter the number of vertices: ");
    scanf("%d", &n);
    printf("\nEnter the adjacency matrix:\n");
    printf("(Enter %d for INF if there is no direct edge)\n\n", INF);
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            scanf("%d", &graph[i][j]);
            if(i==j)
                graph[i][j]=0;
        }
    }
    floydWarshall(graph,n);
    return 0;
}
